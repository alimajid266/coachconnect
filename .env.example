# Server-only Supabase project configuration. Never commit populated .env files.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Browser-safe public token restricted to CoachConnect localhost and production origins.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your-public-mapbox-token

# Optional when the Docker server reaches a local Supabase API through another address.
# SUPABASE_INTERNAL_URL=http://host.docker.internal:54321
