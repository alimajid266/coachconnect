# Server-only Supabase project configuration. Never commit populated .env files.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Required only on the server for media uploads, account deletion, and test setup. Never expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-server-secret-key

# Server-only Google Gemini key for AI search, recommendations, and training plans.
# Create it in Google AI Studio and add the same variable to Vercel. Never prefix it with NEXT_PUBLIC_.
GEMINI_API_KEY=your-gemini-api-key

# Browser-safe public token restricted to CoachConnect localhost and production origins.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your-public-mapbox-token

# Optional when the Docker server reaches a local Supabase API through another address.
# SUPABASE_INTERNAL_URL=http://host.docker.internal:54321
