{
  "name": "coachconnect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pretest": "DATABASE_URL=file:/tmp/coachconnect-test.db prisma db push --force-reset",
    "test:phase0": "node --test scripts/phase0-preview-check.mjs",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "better-sqlite3": "^13.0.2",
    "dotenv": "^17.4.2",
    "mapbox-gl": "^3.27.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.0",
    "jsdom": "^27.2.0",
    "prisma": "^7.9.1",
    "supabase": "^2.111.0",
    "typescript": "^5.9.0",
    "vitest": "4.1.10"
  }
}
